# Copy this file to `.env` and fill in your Sanity project id.
# Find it at https://www.sanity.io/manage (or run `npx sanity projects list`).

# Public — ships in the browser bundle, not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-26

# The site's public origin, no trailing slash. Defaults to http://localhost:3000.
# Set it in production: it is what makes OG image URLs, the sitemap and
# robots.txt absolute.
NEXT_PUBLIC_SITE_URL=

# Analytics — both optional. Leave empty and no third-party script is loaded.
# GTM container id, e.g. GTM-XXXXXXX.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
# Meta (Facebook) pixel id, e.g. 123456789012345.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# --- Form mail (/api/submit-form, /api/test-mail) — env wins over Form settings in the studio ---
# Server-only. `mailjet`, `resend` or `smtp`.
MAIL_PROVIDER=
# Mailjet credentials: https://app.mailjet.com/account/apikeys
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Resend: https://resend.com/api-keys. The sender must be on a domain Resend
# has verified.
RESEND_API_KEY=
# Own SMTP server. SMTP_SECURITY is `starttls` (587), `ssl` (465) or `none`
# (25); SMTP_PORT only when the server uses a non-standard port.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
# Sender address the provider accepts; falls back to CONTACT_ADMIN_EMAIL.
MAIL_FROM_EMAIL=
# Default recipient; a form's own "Recipients" in the studio wins.
CONTACT_ADMIN_EMAIL=
# Guards /api/test-mail (the "Send test mail" button in Form settings).
# Any long random string; the editor pastes it into the studio once.
MAIL_TEST_SECRET=
# Only the one for the spam check picked in Form settings is needed. The site
# keys are public and live there; these are not.
RECAPTCHA_SECRET_KEY=
TURNSTILE_SECRET_KEY=

# Server-only. Needed by `npm run seed` and the Google reviews sync to write documents.
# Create one at https://www.sanity.io/manage -> API -> Tokens, with Editor rights.
SANITY_API_WRITE_TOKEN=

# --- Sentry (optional) ---------------------------------------------------
# Leave the DSN empty and no Sentry code is loaded anywhere: not in the
# browser bundle, not on the server, and the build plugin is skipped.
# Find the DSN under Project settings -> Client Keys (DSN). Not a secret.
NEXT_PUBLIC_SENTRY_DSN=
# Share of transactions traced, 0-1. Defaults to 0.1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Build-time only, for uploading source maps so stack traces are readable.
# Org and project slugs from the Sentry URL; the token from
# https://sentry.io/settings/account/api/auth-tokens/ with project:releases.
# Without the token the build still works, it just skips the upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Unlocks the test page at /sentry-test?secret=<this> (and the API route it
# calls). Leave empty and both answer 404. Server-only; a long random string.
SENTRY_TEST_SECRET=

# --- Cache revalidation ---------------------------------------------------
# Shared secret for the Sanity webhook that calls /api/revalidate after a
# publish. Pick a long random string and enter the same one in the webhook
# (sanity.io/manage -> API -> Webhooks). Server-only.
SANITY_REVALIDATE_SECRET=

# Google reviews sync (/api/google-reviews): Places API (New) key, the secret the
# studio's "Google reviews" panel sends, and the cron's bearer secret (Vercel sets
# CRON_SECRET itself). SERPAPI_API_KEY only for the one-off `npm run reviews:backfill`.
GOOGLE_PLACES_API_KEY=
GOOGLE_REVIEWS_SYNC_SECRET=
CRON_SECRET=
SERPAPI_API_KEY=
