{
  "name": "template-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typegen": "npm --prefix ../studio run typegen",
    "check:jsonld": "tsx scripts/check-jsonld.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "reviews:backfill": "tsx --env-file=.env scripts/backfill-google-reviews.ts",
    "reviews:backfill:dry": "tsx --env-file=.env scripts/backfill-google-reviews.ts --dry"
  },
  "dependencies": {
    "@sanity/image-url": "^2.1.1",
    "@sentry/nextjs": "^10.71.0",
    "next": "16.2.12",
    "next-sanity": "^13.2.1",
    "nodemailer": "^10.0.16",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "groq-js": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
